DJANGO_SECRET_KEY=replace-with-a-long-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=PeopleFlow RH
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_PROVIDER=gemini
# Optional OpenAI provider
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDER=openai
# RAG (ChromaDB + sentence-transformers)
RAG_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_CHUNK_SIZE=800
RAG_TOP_K=4
# E-mail (console par défaut en développement)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@peopleflow.local
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
